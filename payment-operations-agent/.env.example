# OpenAI API key — required if LLM_PROVIDER=openai
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API key — required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# LLM provider to use: "openai" or "anthropic" (default: openai)
LLM_PROVIDER=openai

# Model name for the selected provider
# OpenAI options:    gpt-4o-mini, gpt-4o, gpt-3.5-turbo
# Anthropic options: claude-haiku-3-5-latest, claude-sonnet-4-5
MODEL_NAME=gpt-4o-mini